# ==============================================================================
# Alhambra Vibe Coder Environment Configuration
# Copy this file to .env or .env.local to customize your development setup.
# ==============================================================================

# Runtime Mode: 'development' (uses local source checkouts) or 'production' (uses release binaries)
ALHAMBRA_MODE=development

# Workspace & Repository Paths (leave blank to auto-detect from platform root)
# ANDALUS_SOURCE_PATH=/Users/bhangun/Workspace/workkayys/Products/Andalus/andalus-platform
# GOLLEK_SOURCE_PATH=/Users/bhangun/Workspace/workkayys/Products/Andalus/andalus-platform/Families/gollek
# ALHAMBRA_SOURCE_PATH=/Users/bhangun/Workspace/workkayys/Products/Andalus/andalus-platform/Projects/Andalus-Agents/Alhambra

# Gollek Local Inference Configuration
GGUF_CONTEXT_SIZE=8192
GOLLEK_PORT=8080
GOLLEK_GRPC_PORT=9131

# Alhambra Agent Backend Ports
ALHAMBRA_HTTP_PORT=8085
ALHAMBRA_GRPC_PORT=9000

# Java Runtime (if not in standard PATH or /usr/libexec/java_home)
# JAVA_HOME=/Library/Java/JavaVirtualMachines/openjdk-21.jdk/Contents/Home
