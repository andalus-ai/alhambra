# Alhambra configuration

# Runtime Mode: 'development' or 'production'
ALHAMBRA_MODE=development

# Workspace & Repository Paths (leave commented out to auto-detect):
GOLLEK_SOURCE_PATH=~/Workspace/workkayys/Products/Andalus/andalus-platform/Families/gollek
ANDALUS_SOURCE_PATH=~/Workspace/workkayys/Products/Andalus/andalus-platform/Families/andalus
ALHAMBRA_SOURCE_PATH=~/Workspace/workkayys/Products/Andalus/andalus-platform/Projects/Andalus-Agents/Alhambra/Community/Backend
GGUF_CONTEXT_SIZE=8192


# Gollek Local Inference Configuration
GGUF_CONTEXT_SIZE=8192
GOLLEK_PORT=8080
GOLLEK_GRPC_PORT=9131

# Alhambra Agent Backend Configuration
ALHAMBRA_HTTP_PORT=8085
ALHAMBRA_GRPC_PORT=9000

# Custom Java Home (optional)
# JAVA_HOME=/Library/Java/JavaVirtualMachines/openjdk-21.jdk/Contents/Home